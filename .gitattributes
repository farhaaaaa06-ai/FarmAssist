# ==============================================================================
# FarmAssist: Git Attributes & Line Endings (LF Configuration)
# ==============================================================================

# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# ------------------------------------------------------------------------------
# Source Code & Text Assets (Always normalize to LF)
# ------------------------------------------------------------------------------
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ipynb text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# ------------------------------------------------------------------------------
# Binary Files (Prevent any line-ending normalization/corruption)
# ------------------------------------------------------------------------------
*.pt binary
*.pth binary
*.bin binary
*.onnx binary
*.jpg binary
*.JPG binary
*.jpeg binary
*.png binary
*.ico binary
*.webp binary
*.gif binary
*.pdf binary
*.zip binary
*.tar.gz binary
